+    const entry* find_the_entry(const std::uint64_t k) const
+    {
+        if (const auto p = pending.find(k); p != pending.end()) {
+            return &p->second;
+        }
+        if (pending_cut && k >= *pending_cut) {
+            return nullptr;
+        }
+        const auto c = cached.find(k);
+        return c == cached.end() ? nullptr : &c->second;
+    }
+
+    void keep_the_pending_entries()
+    {
+        if (pending_cut) {
+            cached.erase(cached.lower_bound(*pending_cut), cached.end());
+        }
+        for (auto& [k, e] : pending) {
+            cached.insert_or_assign(k, std::move(e));
+        }
+        pending.clear();
+        pending_cut.reset();
+        while (cached.size() > entries_in_memory_most) {
+            cached.erase(cached.begin());
+        }
+    }
 
