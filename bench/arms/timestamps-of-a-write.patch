+#include <time.h>
+#include <cstdio>
+namespace trace_arm {
+struct ev { std::uint64_t t; char k; std::uint64_t a; std::uint64_t b; };
+inline std::vector<ev>& evs() { static std::vector<ev> v = [] { std::vector<ev> x; x.reserve(1u << 22); return x; }(); return v; }
+inline void mark(char k, std::uint64_t a = 0, std::uint64_t b = 0) {
+    timespec ts; clock_gettime(CLOCK_MONOTONIC, &ts);
+    if (evs().size() < (1u << 22)) evs().push_back({std::uint64_t(ts.tv_sec) * 1000000000u + std::uint64_t(ts.tv_nsec), k, a, b});
+}
+inline void dump(std::uint64_t pid, const std::filesystem::path& dir) {
+    FILE* f = std::fopen((dir / "trace.txt").c_str(), "w");
+    if (!f) return;
+    for (const auto& e : evs()) std::fprintf(f, "%llu %llu %c %llu %llu\n", (unsigned long long)e.t, (unsigned long long)pid, e.k, (unsigned long long)e.a, (unsigned long long)e.b);
+    std::fclose(f);
+}
+}
 
