FROM registry.opensuse.org/opensuse/tumbleweed:latest AS lazyfs
RUN zypper -n -q in --no-recommends gcc-c++ cmake make fuse3-devel && zypper -n clean -a
COPY lazyfs /lazyfs
COPY toml11 /toml11
COPY spdlog /lazyfs/libs/libpcache/build/_deps/spdlog-src
RUN cd /lazyfs/libs/libpcache/build \
 && cmake -DCMAKE_POLICY_VERSION_MINIMUM=3.5 -DFETCHCONTENT_SOURCE_DIR_TOML=/toml11 \
    -DFETCHCONTENT_SOURCE_DIR_SPDLOG=/lazyfs/libs/libpcache/build/_deps/spdlog-src .. \
 && cmake --build . -j"$(nproc)" \
 && mkdir -p /lazyfs/lazyfs/build && cd /lazyfs/lazyfs/build \
 && cmake -DCMAKE_POLICY_VERSION_MINIMUM=3.5 -DLAZYFS_BUILD_TESTS=OFF .. && cmake --build . -j"$(nproc)"

FROM registry.opensuse.org/opensuse/tumbleweed:latest
RUN zypper -n -q in --no-recommends openssh-server openssh-clients sudo bash tar gzip curl procps psmisc iproute2 \
    nftables fuse3 libfuse3-4 sqlite3 util-linux shadow hostname iputils && zypper -n clean -a
COPY --from=lazyfs /lazyfs/lazyfs/build/lazyfs /usr/local/bin/lazyfs
COPY --from=lazyfs /lazyfs/libs/libpcache/build/libpcache.so /usr/local/lib64/libpcache.so
RUN echo /usr/local/lib64 > /etc/ld.so.conf.d/local.conf && ldconfig \
 && ssh-keygen -A \
 && printf 'PermitRootLogin prohibit-password\nPasswordAuthentication no\nUsePAM no\n' > /etc/ssh/sshd_config.d/jepsen.conf \
 && echo user_allow_other >> /etc/fuse.conf \
 && useradd --create-home konsens
COPY control.pub /root/.ssh/authorized_keys
RUN chmod 700 /root/.ssh && chmod 600 /root/.ssh/authorized_keys
CMD ["/bin/sh", "-c", "chmod 666 /dev/fuse && exec /usr/sbin/sshd -D -e"]
